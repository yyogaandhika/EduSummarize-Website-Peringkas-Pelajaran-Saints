# ========================================================
# EduSummarize AI API Configuration
# Pilih salah satu API Key gratis berikut:
# ========================================================

# Pilihan 1: Google Gemini API (Sangat Direkomendasikan untuk Materi Sains)
# Dapatkan gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Pilihan 2: Hugging Face Token
# Dapatkan di: https://huggingface.co/settings/tokens
# HF_TOKEN=

# Pilihan 3: Groq API Key
# Dapatkan di: https://console.groq.com/keys
# GROQ_API_KEY=
